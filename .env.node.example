# --- The data tier's name and certificate: read this once, it decides both URIs below ---
# Both hops out of this host — Postgres and Redis — are now verified TLS, and both check the
# certificate against the HOSTNAME YOU WRITE HERE. So the data VM needs a real DNS name and a
# certificate issued for it. The supported model is a publicly-trusted certificate (Let's
# Encrypt on that VM), because then every client verifies against the CA bundle already in the
# image and needs nothing else configured.
#   A self-signed pair also works, but then it is YOUR job to copy that CA to all four hosts and
#   point sslrootcert / ssl_ca_certs at it — nothing in this repo does that for you.
# Replace data.example.com below with the data VM's own DNS name.
# ─────────────────────────────────────────────────────────────────────────────
# Worker edge node — docker-compose.node.yml
# Copy to .env ON THAT NODE ONLY. Every node gets its own file with its own domains.
#
# There is deliberately no single shared .env.example any more. One file could never
# be correct for every host: RATELIMIT_STORAGE_URI alone has two mutually exclusive
# right values — the box's own Redis here and on the master, the data tier on the sub
# and bot hosts. Every host gets its own file holding only what that host reads.
#
# This host runs: Xray, the worker API (PANEL_ROLE=worker), the node SPA, a
# socket-proxy, its own Redis, and a Caddy terminating TLS for this node's own
# PANEL_DOMAIN plus the raw-TCP decoy route for PROXY_DOMAIN.
# ─────────────────────────────────────────────────────────────────────────────

# --- Images (keep the tags in sync with versions.json) ---
WORKER_IMAGE=ghcr.io/ivantopgaming/panel-worker:v2.4.16
FRONTEND_NODE_IMAGE=ghcr.io/ivantopgaming/panel-frontend-node:v2.4.14
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.2
# The registry publishes only :latest for this image — there are no version tags, so a value
# copied from versions.json fails to pull. versions.json's xray_core_ref is the *source* ref
# the worker image compiles its protobuf stubs from, not a tag for this one.
XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
# On the very first `up` of a node this container restarts a few times before it settles, with
# `open /etc/xray/config.json: no such file or directory` in its log. That is expected and not a
# fault: the config is written by the panel's backend at boot, and until it has, Xray has nothing
# to load. It is deliberately NOT gated behind the backend's healthcheck — on every later restart
# the config already exists, and waiting for the backend there would add tens of seconds of real
# downtime to fix a message that only appears once.
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:vX.Y.Z
REDIS_IMAGE=redis:7.4-alpine
XRAY_EGRESS_IMAGE=ghcr.io/ivantopgaming/panel-egress:v1.0.1

# --- Domains, routing & TLS ---
# PANEL_DOMAIN      — THIS NODE's own admin domain, never the master's. The backend
#                     also uses it as this node's identity in bot events
#                     (services/notifications.py), so a wrong value mislabels every
#                     expiry/traffic warning this node emits.
# PROXY_DOMAIN      — decoy SNI, raw-TCP passthrough to this node's Xray (masquerade).
# PANEL_SECRET_PATH — secret URL prefix; anything outside it returns 404.
# SUB_DOMAIN        — REQUIRED, and it is the subscription host's domain, not this
#                     one. Since wave 3b this node serves no /api/sub/* at all; it reads
#                     the variable only so its own admin UI can hand out working
#                     subscription links (services/sub_links). No fallback exists.
# ./certs on this box must hold a cert covering PANEL_DOMAIN. There is no script for
# it — scripts/generate_certs.sh only works on the host serving the master's domain.
PANEL_DOMAIN=node1.example.com
PROXY_DOMAIN=www.google.com
PANEL_SECRET_PATH=change-this-secret-path
SUB_DOMAIN=sub.example.com
CORS_ORIGINS=https://node1.example.com

# --- Admin login & JWT signing ---
# A node keeps its own Admin row in its own SQLite. That is expected: a password
# change on the master does not propagate here.
SECRET_KEY=change-this-super-long-random-secret
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-this-strong-password

# --- No DATABASE_URL, on purpose ---
# A node does not talk to Postgres at all. Leaving it unset is what makes the backend
# fall back to its own local SQLite in ./db_data, which is the whole point of the node
# role: it keeps passing traffic when the data tier is down.

# --- Redis: two variables, two different instances, split by who needs the data ---
# RATELIMIT_STORAGE_URI — THIS node's own redis container (internal network, no auth,
#                         not reachable from outside). Rate limits, and nothing else that
#                         matters here: the subscription-response cache is only ever
#                         written by the role that serves subscriptions, which since wave
#                         3b is the sub host alone. A node only ever DELETEs from that
#                         cache after a local change — see the note under SHARED_REDIS_URI
#                         for why those deletes do not reach the sub host.
# SHARED_REDIS_URI      — the SHARED data-tier Redis. Everything more than one role
#                         needs lives there: the bot:events channel, the node snapshots
#                         and the panel:refresh nudge. There is no fallback any more —
#                         unset means the stack refuses to start, which is the point:
#                         a PUBLISH into a Redis nobody subscribes to still succeeds, so
#                         the bot_event row is stamped delivered_at and the replay cron
#                         never retries it. The event was then lost for good, silently.
#                         Use the 'node' credential: publish-only into bot:events. It
#                         deliberately cannot touch keys, so this node's subscription-cache
#                         invalidations do not reach the sub host (one log line on first
#                         attempt, harmless — the sub host's own entries expire within
#                         SUB_CACHE_TTL_SECONDS).
# The bus carries the ACL password and bot:events payloads (telegram_id, e-mail) in
# clear — run it over a private network between hosts, or over rediss://.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
SHARED_REDIS_URI=rediss://node:CHANGE_ME@data.example.com:6379/0

# --- Dedicated egress IP: shared token between the backend and the xray-egress sidecar ---
# Only read by GET /api/system/egress/bind-ips; an empty value makes that endpoint 503.
EGRESS_INTERNAL_TOKEN=change-me-long-random
# Optional overrides (defaults shown):
# EGRESS_BIND_POOL_RANGE=172.28.0.128-172.28.0.254
# EGRESS_BIND_PREFIX=24
# Host-level setup (addresses on the uplink, SNAT, policy routing) is NOT configured
# from the panel — the /system/egress/host-script endpoint was removed. Do it by hand
# over SSH until the installer exists.

# --- Logging ---
BACKEND_LOG_LEVEL=INFO
