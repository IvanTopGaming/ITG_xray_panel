
WORKER_IMAGE=ghcr.io/ivantopgaming/panel-worker:v2.4.16
FRONTEND_NODE_IMAGE=ghcr.io/ivantopgaming/panel-frontend-node:v2.4.14
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.2
XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:vX.Y.Z
REDIS_IMAGE=redis:7.4-alpine
XRAY_EGRESS_IMAGE=ghcr.io/ivantopgaming/panel-egress:v1.0.1

PANEL_DOMAIN=node1.example.com
PROXY_DOMAIN=www.google.com
PANEL_SECRET_PATH=change-this-secret-path
SUB_DOMAIN=sub.example.com
CORS_ORIGINS=https://node1.example.com

SECRET_KEY=change-this-super-long-random-secret
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-this-strong-password

RATELIMIT_STORAGE_URI=redis://redis:6379/0
SHARED_REDIS_URI=rediss://node:CHANGE_ME@data.example.com:6379/0

EGRESS_INTERNAL_TOKEN=change-me-long-random

BACKEND_LOG_LEVEL=INFO
