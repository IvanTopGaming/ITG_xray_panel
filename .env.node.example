# ═════════════════════════════════════════════════════════════════════════════
#  NODE  ·  Xray + node SPA  ·  docker-compose.node.yml
#  cp .env.node.example .env   —  on this node only, one file per node
#
#  The only role that runs Xray. It holds no database credential and its Redis
#  credential is publish-only, which is what makes it safe in an untrusted
#  segment. Its own SQLite is the cache, migrated by the node itself.
#  Link it afterwards: node → System → Link, then master → Panels → Add panel.
# ═════════════════════════════════════════════════════════════════════════════

# ── Images ───────────────────────────────────────────────────────────────────
WORKER_IMAGE=ghcr.io/ivantopgaming/panel-worker:v2.4.17
FRONTEND_NODE_IMAGE=ghcr.io/ivantopgaming/panel-frontend-node:v2.4.15
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.3
XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:vX.Y.Z
REDIS_IMAGE=redis:7.4-alpine
XRAY_EGRESS_IMAGE=ghcr.io/ivantopgaming/panel-egress:v1.0.1

# ── Domains & TLS ────────────────────────────────────────────────────────────
# PROXY_DOMAIN must equal the REALITY inbound's SNI. Caddy routes :443 by SNI,
# so a mismatch hands every client to the panel instead of Xray, silently.
# SUB_DOMAIN names the subscription host, not this node, and it is required here:
# every link this node's Dashboard hands out is built from it, with no fallback.
PANEL_DOMAIN=node1.example.com             # THIS node's own, not the master's
PROXY_DOMAIN=www.google.com                # decoy; raw TCP passthrough to Xray
PANEL_SECRET_PATH=change-this-secret-path  # panel lives at /<this>/, else 404
SUB_DOMAIN=sub.example.com                 # the SUB host, not this one
CORS_ORIGINS=https://node1.example.com     # origin allowed to call the API

# ── Admin login & JWT ────────────────────────────────────────────────────────
# This node keeps its own admin account, separate from the master's.
SECRET_KEY=change-this-super-long-random-secret   # JWT signing key, 32+ chars
PANEL_ADMIN_USER=admin                            # first-boot admin; changeable in the UI
PANEL_ADMIN_PASSWORD=change-this-strong-password  # change before first boot

# ── Redis ────────────────────────────────────────────────────────────────────
# No DATABASE_URL here, deliberately: a node never reaches the shared Postgres.
# Its data-tier credential is 'node' — publish into bot:events and nothing else.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
SHARED_REDIS_URI=rediss://node:CHANGE_ME@data.example.com:6379/0

# ── TLS ──────────────────────────────────────────────────────────────────────
# Caddy issues and renews the certificate itself over ACME, for PANEL_DOMAIN
# only — PROXY_DOMAIN is a raw passthrough to Xray and is never requested.
# Requirements: PANEL_DOMAIN resolves here and :80 is reachable.
ACME_EMAIL=                                  # optional; LE warning address
ACME_CA=                                     # optional; LE staging URL

# ── Optional ─────────────────────────────────────────────────────────────────
EGRESS_INTERNAL_TOKEN=change-me-long-random  # only for the dedicated-egress IP
BACKEND_LOG_LEVEL=INFO                       # DEBUG also echoes every SQL statement
