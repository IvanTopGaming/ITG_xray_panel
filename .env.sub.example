# ═════════════════════════════════════════════════════════════════════════════
#  SUB  ·  subscription links + the subscription page  ·  docker-compose.sub.yml
#  cp .env.sub.example .env   —  on the subscription box only
#
#  The only role serving /api/sub/*. It is a WRITER of the shared Postgres: the
#  device ledger is written on every config request, so a read-only credential
#  breaks config delivery rather than merely failing to count.
# ═════════════════════════════════════════════════════════════════════════════

# ── Images ───────────────────────────────────────────────────────────────────
SUB_IMAGE=ghcr.io/ivantopgaming/panel-sub:v3.0.1
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v3.0.1

# ── Domains & TLS ────────────────────────────────────────────────────────────
SUB_DOMAIN=sub.example.com      # this host; Caddy gets its cert for it
PANEL_DOMAIN=panel.example.com  # routes nothing here; the "real deploy" marker

# ── Admin login & JWT ────────────────────────────────────────────────────────
SECRET_KEY=change-this-super-long-random-secret  # JWT signing key, 32+ chars

# ── Data tier ────────────────────────────────────────────────────────────────
# Needs INSERT/UPDATE/DELETE on user_device — use the same 'panel' credential
# the master uses. sslrootcert points at the data tier's own CA, mounted in by
# the compose file: verify-full is enforced and that CA is in no public store.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data.example.com:5432/panel?sslmode=verify-full&sslrootcert=/etc/ssl/panel-ca.crt

# ── Redis ────────────────────────────────────────────────────────────────────
# This host runs no Redis of its own, so both point at the data tier. An
# unreachable one no longer refuses requests — the rate limits move in-process.
RATELIMIT_STORAGE_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0?ssl_ca_certs=/etc/ssl/panel-ca.crt
SHARED_REDIS_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0?ssl_ca_certs=/etc/ssl/panel-ca.crt

# ── TLS ──────────────────────────────────────────────────────────────────────
# Caddy issues and renews the certificate itself over ACME. Requirements:
# SUB_DOMAIN resolves here and :80 is reachable from the internet.
# optional; where Let's Encrypt mails warnings
ACME_EMAIL=
# optional; LE staging URL while rehearsing
ACME_CA=

# ── Optional ─────────────────────────────────────────────────────────────────
BACKEND_LOG_LEVEL=INFO  # DEBUG also echoes every SQL statement
