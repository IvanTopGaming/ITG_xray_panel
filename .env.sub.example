# ─────────────────────────────────────────────────────────────────────────────
# Standalone subscription host — docker-compose.sub.yml
# Copy to .env ON THE SUB BOX ONLY.
#
# There is deliberately no single shared .env.example any more. One file could never
# be correct for every host: RATELIMIT_STORAGE_URI alone has two mutually exclusive
# right values — the box's own Redis on the master and on a node, the data tier here
# and on the bot host. Every host gets its own file holding only what that host reads.
#
# This host runs: the subscription API (PANEL_ROLE=sub) plus the React subscription
# page baked into the panel-sub image, and a Caddy terminating TLS for SUB_DOMAIN and
# nothing else. It has no local Redis and no scheduler.
# ─────────────────────────────────────────────────────────────────────────────

# --- Images (keep the tags in sync with versions.json) ---
SUB_IMAGE=ghcr.io/ivantopgaming/panel-sub:v2.4.15
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.2

# --- Domains, routing & TLS ---
# SUB_DOMAIN        — THIS host's domain, and the only route its Caddy serves.
#                     ./certs on this box must hold a cert covering it; issue it by
#                     hand (scripts/generate_certs.sh only works on the master's host).
# PANEL_DOMAIN      — read by api/subscription.py as the default server address when an
#                     inbound carries no explicit host. Not served here, not routed here.
# No PANEL_SECRET_PATH here: the only module that reads it is api/federation.py, which
# ships from panel-adminapi and is not installed in the panel-sub image.
PANEL_DOMAIN=panel.example.com
SUB_DOMAIN=sub.example.com

# --- JWT signing ---
# No PANEL_ADMIN_* here: this role never calls bootstrap_defaults and creates no Admin
# row. It registers no auth blueprint either.
SECRET_KEY=change-this-super-long-random-secret

# --- Data tier ---
# This role WRITES to Postgres and needs a credential that can. Since wave 3b the device
# limit is enforced here and nowhere else: every config request registers or refreshes a
# user_device row. A read-only user makes the gate raise on the hot path — it was enough
# only while the gate short-circuited on this role.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data-vm.internal:5432/panel?sslmode=verify-full

# --- Redis: two variables, one instance on this host ---
# There is no local Redis here, so both point at the data tier — but they are now two
# separate variables everywhere, because on the master and on a node they are two
# different servers. Spell both out rather than letting one default to the other: that
# default was the trap that silently lost every bot event on hosts with a local Redis.
# RATELIMIT_STORAGE_URI — rate limits and this role's subscription cache.
# SHARED_REDIS_URI      — the node snapshots this role reads to build subscriptions.
RATELIMIT_STORAGE_URI=redis://panel:CHANGE_ME@data-vm.internal:6379/0
SHARED_REDIS_URI=redis://panel:CHANGE_ME@data-vm.internal:6379/0

# --- Logging ---
BACKEND_LOG_LEVEL=INFO
