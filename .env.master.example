# ─────────────────────────────────────────────────────────────────────────────
# Master / orchestrator host — docker-compose.master.yml
# Copy to .env ON THE MASTER BOX ONLY.
#
# There is deliberately no single shared .env.example any more. One file could never
# be correct for every host: RATELIMIT_STORAGE_URI alone has two mutually exclusive
# right values — the box's own Redis here and on a node, the data tier on the sub and
# bot hosts. Every host gets its own file holding only what that host reads.
#
# This host runs: the admin API (PANEL_ROLE=master), the admin SPA, its own Redis for
# rate limiting, and a Caddy that terminates TLS for PANEL_DOMAIN and nothing else.
# ─────────────────────────────────────────────────────────────────────────────

# --- Images (keep the tags in sync with versions.json) ---
MASTER_IMAGE=ghcr.io/ivantopgaming/panel-master:v2.4.12
FRONTEND_ADMIN_IMAGE=ghcr.io/ivantopgaming/panel-frontend-admin:v2.4.10
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.2
REDIS_IMAGE=redis:7.4-alpine

# --- Domains, routing & TLS ---
# PANEL_DOMAIN      — THIS host's admin domain. ./certs must hold a cert covering it.
# PANEL_SECRET_PATH — secret URL prefix; anything outside it returns 404.
# SUB_DOMAIN        — REQUIRED, and it is the subscription host's domain, not this
#                     one. Subscriptions are served by the sub role alone since wave
#                     3b; this box answers no /api/sub/* at all. Its backend reads the
#                     variable only to build the links the Dashboard hands out
#                     (services/sub_links). There is no fallback any more: unset it and
#                     every "Copy sub URL" button would have nowhere to point.
# No PROXY_DOMAIN here: the master has had no xray service since phase 3b, so the
# decoy route has no upstream to point at.
PANEL_DOMAIN=panel.example.com
PANEL_SECRET_PATH=change-this-secret-path
SUB_DOMAIN=sub.example.com
CORS_ORIGINS=https://panel.example.com

# --- Admin login & JWT signing ---
SECRET_KEY=change-this-super-long-random-secret
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-this-strong-password

# --- Data tier ---
# DATABASE_URL must reach the Postgres VM. sslmode=verify-full is enforced by
# db_config.validate_database_uri, so the host name has to match the server cert.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data-vm.internal:5432/panel?sslmode=verify-full

# --- Redis: two variables, two different instances, split by who needs the data ---
# RATELIMIT_STORAGE_URI — THIS stack's own redis container (internal network, no auth,
#                         not reachable from outside). Rate limits, and nothing else that
#                         matters here: the subscription-response cache is only ever
#                         written by the role that serves subscriptions, which since wave
#                         3b is the sub host alone. This host only ever DELETEs from that
#                         cache after an admin edit, and those deletes also go to the
#                         shared Redis, which is where the sub host's copy lives.
# SHARED_REDIS_URI      — the SHARED data-tier Redis. Everything more than one role
#                         needs lives there: the bot:events channel, the node snapshots
#                         this panel reads, and the panel:refresh nudge it publishes
#                         after every admin action on a node. There is no fallback any
#                         more — unset means the stack refuses to start, which is the
#                         point: a PUBLISH into a Redis nobody subscribes to still
#                         succeeds, so the event was marked delivered and lost silently.
#                         Use the 'panel' credential (full access) on this host.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
SHARED_REDIS_URI=redis://panel:CHANGE_ME@data-vm.internal:6379/0

# --- Logging ---
# BACKEND_LOG_LEVEL — DEBUG | INFO | WARNING | ERROR (DEBUG also echoes every SQL statement)
BACKEND_LOG_LEVEL=INFO
