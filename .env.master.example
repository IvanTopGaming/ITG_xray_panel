# ═════════════════════════════════════════════════════════════════════════════
#  MASTER  ·  admin API + admin SPA  ·  docker-compose.master.yml
#  cp .env.master.example .env   —  on the master box only
#
#  No local Xray, no billing, no scheduler here. Boot order is load-bearing:
#  the cron host owns the schema, and this one refuses to start without it.
#      data tier  →  cron  →  master, sub, bot      (nodes: any time after data)
# ═════════════════════════════════════════════════════════════════════════════

# ── Images ───────────────────────────────────────────────────────────────────
MASTER_IMAGE=ghcr.io/ivantopgaming/panel-master:v3.1.0
FRONTEND_ADMIN_IMAGE=ghcr.io/ivantopgaming/panel-frontend-admin:v3.1.1
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v3.0.1
REDIS_IMAGE=redis:7.4-alpine

# ── Domains & TLS ────────────────────────────────────────────────────────────
# SUB_DOMAIN names the subscription host, not this one, and it is required here:
# every link this panel hands out is built from it, and there is no fallback.
PANEL_DOMAIN=panel.example.com             # this host; Caddy gets its cert for it
PANEL_SECRET_PATH=change-this-secret-path  # panel lives at /<this>/, else 404
SUB_DOMAIN=sub.example.com                 # the SUB host, not this one
CORS_ORIGINS=https://panel.example.com     # origin allowed to call the API

# ── Admin login & JWT ────────────────────────────────────────────────────────
SECRET_KEY=change-this-super-long-random-secret   # JWT signing key, 32+ chars
PANEL_ADMIN_USER=admin                            # first-boot admin; changeable in the UI
PANEL_ADMIN_PASSWORD=change-this-strong-password  # change before first boot

# ── Data tier ────────────────────────────────────────────────────────────────
# sslrootcert points at the data tier's own CA, mounted into this container by
# the compose file. It is NOT optional and cannot be dropped: verify-full is
# enforced, the CA is not in any public trust store, and libpq's own fallback
# (~/.postgresql/root.crt) does not exist here. The installer writes ./ca.crt.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data.example.com:5432/panel?sslmode=verify-full&sslrootcert=/etc/ssl/panel-ca.crt

# ── Redis: two instances, split by who needs the data ────────────────────────
# The first is this stack's own container and holds rate limits. The second is
# the data tier: node snapshots, the bot:events bus, the panel:refresh nudge.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
SHARED_REDIS_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0?ssl_ca_certs=/etc/ssl/panel-ca.crt

# ── TLS ──────────────────────────────────────────────────────────────────────
# Caddy issues and renews the certificate itself over ACME, on first boot and
# every 60 days after. Nothing to install, nothing to schedule. Requirements:
# PANEL_DOMAIN resolves here and :80 is reachable from the internet.
# optional; where Let's Encrypt mails warnings
ACME_EMAIL=
# optional; LE staging URL while rehearsing
ACME_CA=

# ── Optional ─────────────────────────────────────────────────────────────────
BACKEND_LOG_LEVEL=INFO          # DEBUG also echoes every SQL statement
# 'true' allows linking a node on a private IP
FEDERATION_ALLOW_PRIVATE_URLS=
