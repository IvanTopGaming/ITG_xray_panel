# ═════════════════════════════════════════════════════════════════════════════
#  CRON  ·  every background job  ·  docker-compose.cron.yml
#  cp .env.cron.example .env   —  on the cron box only
#
#  Publishes no ports, serves no route, needs no certificate. It OWNS the shared
#  schema — nothing else migrates it — so it boots before master, sub and bot.
#  While it is down nodes go unpolled: subscriptions and the bot fall back to
#  the last snapshot, free tariffs stop renewing, events stop being replayed.
#  Put it next to the data tier, not on it: it needs outbound HTTP to every node.
# ═════════════════════════════════════════════════════════════════════════════

# ── Images ───────────────────────────────────────────────────────────────────
CRON_IMAGE=ghcr.io/ivantopgaming/panel-cron:v3.1.0

# ── Data tier ────────────────────────────────────────────────────────────────
# sslrootcert points at the data tier's own CA, mounted into this container by
# the compose file. It is NOT optional and cannot be dropped: verify-full is
# enforced, the CA is not in any public trust store, and libpq's own fallback
# (~/.postgresql/root.crt) does not exist here. The installer writes ./ca.crt.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data.example.com:5432/panel?sslmode=verify-full&sslrootcert=/etc/ssl/panel-ca.crt

# Where this host writes what it polls: node snapshots, status, last_poll.
SHARED_REDIS_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0?ssl_ca_certs=/etc/ssl/panel-ca.crt

# ── Optional ─────────────────────────────────────────────────────────────────
BACKEND_LOG_LEVEL=INFO   # DEBUG also echoes every SQL statement
BACKEND_SLOW_SQL_MS=200  # statements slower than this are logged as WARNING
