# ─────────────────────────────────────────────────────────────────────────────
# Background-jobs host — docker-compose.cron.yml
# Copy to .env ON THE CRON BOX ONLY.
#
# There is deliberately no single shared .env.example any more. One file could never
# be correct for every host. Every host gets its own file holding only what it reads.
#
# This host runs one container and publishes no ports. It polls every node, renews free
# tariffs, replays undelivered bot events, prunes old rows and checks for new releases.
# It is also the ONLY service allowed to migrate the shared Postgres schema.
#
# Put it NEXT TO the data VM, not ON it. It is the first service in this deployment that
# needs outbound HTTP to every node, and the data VM's whole value is that it has no
# outbound connections at all.
#
# Start order: data tier -> THIS HOST -> master, sub, bot-api. The master no longer
# creates the schema; on a virgin database it now refuses to start and says so.
# ─────────────────────────────────────────────────────────────────────────────

# --- Image (keep the tag in sync with versions.json) ---
CRON_IMAGE=ghcr.io/ivantopgaming/panel-cron:v2.4.15

# --- Data tier ---
# --- The data tier's name and certificate: read this once, it decides both URIs below ---
# Both hops out of this host — Postgres and Redis — are now verified TLS, and both check the
# certificate against the HOSTNAME YOU WRITE HERE. So the data VM needs a real DNS name and a
# certificate issued for it. The supported model is a publicly-trusted certificate (Let's
# Encrypt on that VM), because then every client verifies against the CA bundle already in the
# image and needs nothing else configured.
#   A self-signed pair also works, but then it is YOUR job to copy that CA to all four hosts and
#   point sslrootcert / ssl_ca_certs at it — nothing in this repo does that for you.
# Replace data.example.com below with the data VM's own DNS name.
# Same credentials as the master's DATABASE_URL. sslmode=verify-full is required here
# unconditionally: the relaxation for local development is keyed off a role having a public
# surface at all (build_base_app(..., public_surface=False)), and this one has none — so
# setting PANEL_DOMAIN=localhost here would NOT relax it, unlike on the master.
# sslrootcert is NOT optional: libpq looks for ~/.postgresql/root.crt, which does not exist
# in our images, and sslrootcert=system does not help either (psycopg2-binary bundles its own
# OpenSSL whose compiled-in CA path is absent). Without this parameter every role fails to
# connect with 'certificate verify failed'. The path below is the CA bundle in the image.
# The data tier must therefore serve a certificate signed by a public CA and issued for the
# exact hostname used here — a self-signed pair would need its own CA copied to every host
# and this path pointed at it.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data.example.com:5432/panel?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt

# --- Shared Redis (data tier) ---
# Carries the bot:events bus, the node snapshots and the panel:refresh channel this
# service subscribes to. Use the 'panel' credential — the publish-only 'node' one cannot
# write snapshots or subscribe.
# There is no RATELIMIT_STORAGE_URI on this host: the role serves no rate-limited route.
SHARED_REDIS_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0

# --- Logging ---
# BACKEND_LOG_LEVEL — DEBUG | INFO | WARNING | ERROR (DEBUG also echoes every SQL statement)
# BACKEND_SLOW_SQL_MS — statements slower than this are logged at WARNING
BACKEND_LOG_LEVEL=INFO
BACKEND_SLOW_SQL_MS=200
