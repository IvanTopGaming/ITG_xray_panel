XRAY_IMAGE=ghcr.io/xtls/xray-core:vX.Y.Z
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:vX.Y.Z
REDIS_IMAGE=redis:7.4-alpine
BACKEND_IMAGE=ghcr.io/ivantopgaming/panel-backend:v2.1.4
FRONTEND_IMAGE=ghcr.io/ivantopgaming/panel-frontend:v2.1.2
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.0.2
BOT_IMAGE=ghcr.io/ivantopgaming/panel-bot:v2.1.2

# Used only when building backend image from source.
XRAY_CORE_REF=REPLACE_WITH_XRAY_CORE_TAG_OR_COMMIT

PANEL_DOMAIN=panel.example.com
PROXY_DOMAIN=www.google.com
PANEL_SECRET_PATH=change-this-secret-path
SECRET_KEY=change-this-super-long-random-secret
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-this-strong-password
CORS_ORIGINS=https://panel.example.com
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Proxy for the bot's calls to api.telegram.org. Empty = direct.
# Any HTTP/HTTPS/SOCKS5 URL works (aiohttp-socks). Examples:
#   http://1.2.3.4:8118
#   socks5://user:pass@1.2.3.4:1080
TELEGRAM_PROXY_URL=

# Bot service token — fill after first panel start.
# Open the panel UI → Bot → Settings → Rotate token, then paste here and
# restart the bot service:  docker compose up -d bot
BOT_SERVICE_TOKEN=

# Where the bot reaches the panel API. Default works inside docker compose;
# override only if the bot runs outside the panel's network.
BACKEND_API_URL=http://backend:5000/api

# Bot log level — DEBUG / INFO / WARNING / ERROR.
BOT_LOG_LEVEL=INFO
