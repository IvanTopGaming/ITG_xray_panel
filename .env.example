# Container images
# Base images needed in every environment. In production the panel images
# (backend/frontend/caddy/bot/metrics) are pulled from GHCR — keep the pins
# in sync with versions.json. Dev builds locally; staging hardcodes :dev-latest.
XRAY_IMAGE=ghcr.io/xtls/xray-core:vX.Y.Z
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:vX.Y.Z
REDIS_IMAGE=redis:7.4-alpine

BACKEND_IMAGE=ghcr.io/ivantopgaming/panel-backend:v2.4.1
FRONTEND_IMAGE=ghcr.io/ivantopgaming/panel-frontend:v2.4.0
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.1
BOT_IMAGE=ghcr.io/ivantopgaming/panel-bot:v2.2.1
METRICS_IMAGE=ghcr.io/ivantopgaming/panel-metrics:v1.0.1
XRAY_EGRESS_IMAGE=ghcr.io/ivantopgaming/panel-egress:v1.0.1

# Build from source
# Xray-core tag/commit compiled into the backend image. Only the dev
# docker-compose.yml (build: ./backend) reads this — ignored with prebuilt images.
XRAY_CORE_REF=REPLACE_WITH_XRAY_CORE_TAG_OR_COMMIT

# Domains, routing & TLS
# PANEL_DOMAIN      — where the panel is served
# PROXY_DOMAIN      — decoy SNI, raw-TCP passthrough to Xray (masquerade)
# PANEL_SECRET_PATH — secret URL prefix; anything outside it returns 404
# SUB_DOMAIN        — optional dedicated subscription domain (must be in the cert SAN)
PANEL_DOMAIN=panel.example.com
PROXY_DOMAIN=www.google.com
PANEL_SECRET_PATH=change-this-secret-path
SUB_DOMAIN=

# Admin login & security
# SECRET_KEY   — long random string used to sign JWTs
# CORS_ORIGINS — comma-separated allowed origins (usually just the panel URL)
SECRET_KEY=change-this-super-long-random-secret
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-this-strong-password
CORS_ORIGINS=https://panel.example.com

# Runtime & logging
# RATELIMIT_STORAGE_URI — Redis URI for rate limiting + sub-cache
# *_LOG_LEVEL           — DEBUG | INFO | WARNING | ERROR
RATELIMIT_STORAGE_URI=redis://redis:6379/0
BACKEND_LOG_LEVEL=INFO
BOT_LOG_LEVEL=INFO

# Telegram bot
# BOT_SERVICE_TOKEN — fill after first login (Panel → Bot → Settings → rotate token).
#   Everything else (bot_token, admin IDs, telegram proxy, YooKassa, timezone)
#   is configured in that UI, not here.
# BACKEND_API_URL   — how the bot reaches the backend (default is usually fine).
BOT_SERVICE_TOKEN=
BACKEND_API_URL=http://backend:5000/api

# Dedicated egress IP: shared token between backend and the xray-egress sidecar
EGRESS_INTERNAL_TOKEN=change-me-long-random
# Optional overrides (defaults shown):
# EGRESS_BIND_POOL_RANGE=172.28.0.128-172.28.0.254
# EGRESS_BIND_PREFIX=24
# EGRESS_UPLINK_IFACE=eth0  # HOST uplink NIC (e.g. eth0/ens3) used by the generated host-script; read by the backend container. The xray-egress sidecar always binds via the container's own eth0 and ignores this var.

# --- Postgres (master data tier) ---
# DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@pg-host:5432/panel?sslmode=verify-full
POSTGRES_USER=panel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=panel
POSTGRES_BIND=0.0.0.0
