# Container images
# Base images needed in every environment. In production the panel images
# (master/worker/sub/bot-api/frontend-admin/frontend-node/caddy/bot) are pulled from GHCR —
# keep the pins in sync with versions.json. Dev builds locally; staging hardcodes :dev-latest.
# The backend is split into four per-role images — each split stack only
# needs the one matching its role: MASTER_IMAGE (docker-compose.master.yml),
# WORKER_IMAGE (docker-compose.node.yml), SUB_IMAGE (docker-compose.sub.yml),
# BOT_API_IMAGE (docker-compose.bot.yml).
# The frontend is likewise split into two per-app images: FRONTEND_ADMIN_IMAGE
# (docker-compose.master.yml) serves the admin SPA, FRONTEND_NODE_IMAGE
# (docker-compose.node.yml) serves the node-only SPA.
XRAY_IMAGE=ghcr.io/xtls/xray-core:vX.Y.Z
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:vX.Y.Z
REDIS_IMAGE=redis:7.4-alpine

MASTER_IMAGE=ghcr.io/ivantopgaming/panel-master:v2.4.1
WORKER_IMAGE=ghcr.io/ivantopgaming/panel-worker:v2.4.1
SUB_IMAGE=ghcr.io/ivantopgaming/panel-sub:v2.4.2
BOT_API_IMAGE=ghcr.io/ivantopgaming/panel-bot-api:v2.4.1
FRONTEND_ADMIN_IMAGE=ghcr.io/ivantopgaming/panel-frontend-admin:v2.4.2
FRONTEND_NODE_IMAGE=ghcr.io/ivantopgaming/panel-frontend-node:v2.4.2
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.2
BOT_IMAGE=ghcr.io/ivantopgaming/panel-bot:v2.2.1
XRAY_EGRESS_IMAGE=ghcr.io/ivantopgaming/panel-egress:v1.0.1

# Build from source
# Xray-core tag/commit compiled into the worker image (backend/Dockerfile.worker) —
# the only one of the four per-role backend images that carries the Xray runtime.
# Only the dev docker-compose.yml (build: ./backend) reads this — ignored with prebuilt images.
XRAY_CORE_REF=REPLACE_WITH_XRAY_CORE_TAG_OR_COMMIT

# Domains, routing & TLS
# PANEL_DOMAIN      — where the panel is served
# PROXY_DOMAIN      — decoy SNI, raw-TCP passthrough to Xray (masquerade)
# PANEL_SECRET_PATH — secret URL prefix; anything outside it returns 404
# SUB_DOMAIN        — dedicated subscription domain (must be in the cert SAN). REQUIRED for the
#                     subscription page: only the sub role bakes the page bundle, so with this
#                     empty the link falls back to PANEL_DOMAIN, lands on the master and 503s in
#                     a browser (client apps still get their raw configs either way)
# BOT_DOMAIN        — dedicated bot-host domain, publishes ONLY the YooKassa webhook
#                     (/api/billing/yookassa/webhook); must be in the cert SAN of the
#                     bot host; leave empty everywhere else so its route is dropped
PANEL_DOMAIN=panel.example.com
PROXY_DOMAIN=www.google.com
PANEL_SECRET_PATH=change-this-secret-path
SUB_DOMAIN=
BOT_DOMAIN=

# Admin login & security
# SECRET_KEY   — long random string used to sign JWTs
# CORS_ORIGINS — comma-separated allowed origins (usually just the panel URL)
SECRET_KEY=change-this-super-long-random-secret
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=change-this-strong-password
CORS_ORIGINS=https://panel.example.com

# Runtime & logging
# RATELIMIT_STORAGE_URI — Redis URI for rate limiting + sub-cache
# *_LOG_LEVEL           — DEBUG | INFO | WARNING | ERROR
RATELIMIT_STORAGE_URI=redis://redis:6379/0
BACKEND_LOG_LEVEL=INFO
BOT_LOG_LEVEL=INFO

# BOT_EVENTS_REDIS_URI — шина событий бота (канал bot:events).
# Дефолт — RATELIMIT_STORAGE_URI, и это ловушка. Правило: роль обязана задать переменную
# ЯВНО, если её RATELIMIT_STORAGE_URI смотрит в ЛОКАЛЬНЫЙ Redis. Таких ролей две —
# МАСТЕР и НОДА: у обеих в стеке свой контейнер redis во внутренней сети (rate-limit +
# кэш подписок), и дефолт увёл бы события в Redis, у которого нет ни одного подписчика.
# Потерянное так событие теряется НАВСЕГДА: publish в локальный Redis успешен, строка
# bot_event помечается delivered_at, и replay-крон её больше не трогает.
# Поэтому docker-compose.master.yml и docker-compose.node.yml требуют переменную через `:?`.
# SUB и БОТ живут без локального Redis — их RATELIMIT_STORAGE_URI и так указывает на
# дата-тир, дефолта достаточно (задать явно не мешает).
#   нода:      BOT_EVENTS_REDIS_URI=redis://node:<REDIS_NODE_PASSWORD>@<data-vm>:6379/0
#   остальные: BOT_EVENTS_REDIS_URI=redis://panel:<REDIS_PANEL_PASSWORD>@<data-vm>:6379/0
# ОБЯЗАТЕЛЬНО: шина ходит между хостами, и по ней едут ACL-пароль и содержимое bot:events
# (telegram_id и email клиентов). Пускайте её либо по приватной сети между хостами, либо
# через TLS — rediss://. Голый redis:// поверх публичного интернета недопустим.
BOT_EVENTS_REDIS_URI=

# Пароли пользователей Redis дата-тира (docker-compose.postgres.yml).
# node — только PUBLISH в bot:events; panel — полный доступ (мастер, bot-api, sub, бот).
# Пароль едет внутри URI (redis://user:PASS@host), поэтому символы @ : / ? # нужно percent-кодировать.
# Проще взять пароль без них, например: openssl rand -hex 32
REDIS_PANEL_PASSWORD=
REDIS_NODE_PASSWORD=

# Telegram bot
# BOT_SERVICE_TOKEN — fill after first login (Panel → Bot → Settings → rotate token).
#   Everything else (bot_token, admin IDs, telegram proxy, YooKassa, timezone)
#   is configured in that UI, not here.
# BACKEND_API_URL   — how the bot reaches the backend (default is usually fine).
BOT_SERVICE_TOKEN=
BACKEND_API_URL=http://backend:5000/api

# Dedicated egress IP: shared token between backend and the xray-egress sidecar
EGRESS_INTERNAL_TOKEN=change-me-long-random
# Optional overrides (defaults shown):
# EGRESS_BIND_POOL_RANGE=172.28.0.128-172.28.0.254
# EGRESS_BIND_PREFIX=24
# EGRESS_UPLINK_IFACE=eth0  # HOST uplink NIC (e.g. eth0/ens3) used by the generated host-script; read by the backend container. The xray-egress sidecar always binds via the container's own eth0 and ignores this var.

# --- Data tier (docker-compose.postgres.yml: Postgres + the shared Redis event bus) ---
# DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@pg-host:5432/panel?sslmode=verify-full
POSTGRES_USER=panel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=panel
# *_BIND — which host interface the port is published on. Default 0.0.0.0 means the whole
# internet if the VM has a public IP; the Redis bus has no TLS of its own, so narrow this to
# the private-network address of the data VM unless the bus runs over rediss://.
POSTGRES_BIND=0.0.0.0
REDIS_BIND=0.0.0.0

# Node role: 'master' (full panel), 'worker' (edge node — no billing/bot/notification crons, no master-only API/tabs), 'sub' (dedicated subscription host — only /api/sub, no crons, no local admin), or 'bot' (dedicated bot backend — only bot_service+billing, no crons, no local admin)
# NOT a .env knob: the role is pinned by the compose file you deploy, because it must match the
# gunicorn entrypoint (panel_core.roles.<role>:create_app) that same file hard-codes. Each backend
# factory binds PANEL_ROLE itself and refuses to boot if the environment contradicts it.
# Pick a role by picking a compose file: master/prod/dev -> master, node -> worker, sub -> sub, bot -> bot.

# --- Split deployment topology ---
# One host per compose file, each with its own .env:
#   docker-compose.postgres.yml — the Postgres data tier (POSTGRES_* above)
#   docker-compose.master.yml   — admin/orchestrator control plane: xray, backend
#                                 (PANEL_ROLE=master), the admin frontend, caddy, redis.
#                                 Needs DATABASE_URL pointed at the remote Postgres (RW user).
#   docker-compose.node.yml     — worker edge node: same services minus bot, no
#                                 Postgres/DATABASE_URL — runs PANEL_ROLE=worker against
#                                 its own local SQLite (./db_data) as a cache/fallback.
#   docker-compose.sub.yml      — standalone subscription host (see below)
#   docker-compose.bot.yml      — standalone bot host (see below)

# --- Master orchestrator (docker-compose.master.yml) ---
# Keeps its own local Redis for rate limiting and the sub-cache, so RATELIMIT_STORAGE_URI
# stays on redis://redis:6379/0 — but BOT_EVENTS_REDIS_URI must be pointed at the data tier
# by hand. The master is the busiest publisher of bot:events (payment_*, access_*,
# texts_changed, the whole YooKassa provisioning path); left on the default it would publish
# into its own internal Redis, which the bot cannot reach and never will.
# DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@pg-host:5432/panel?sslmode=verify-full
# BOT_EVENTS_REDIS_URI=redis://panel:CHANGE_ME@data-vm-host:6379/0

# --- Worker edge node (docker-compose.node.yml) ---
# No DATABASE_URL — leave unset so the backend falls back to local SQLite (./db_data).
# PANEL_ROLE is pinned to 'worker' by docker-compose.node.yml — do not set it here.
# Like the master, it has a local Redis, so the bus must be set explicitly — with the
# publish-only 'node' credential, not 'panel'.
# BOT_EVENTS_REDIS_URI=redis://node:CHANGE_ME@data-vm-host:6379/0

# --- Standalone subscription host (docker-compose.sub.yml) ---
# Runs PANEL_ROLE=sub against the data tier's Postgres (read-only user) and Redis, behind
# its own Caddy terminating TLS for SUB_DOMAIN (set above) — needs a cert covering SUB_DOMAIN on this host.
# DATABASE_URL=postgresql+psycopg2://panel_ro:CHANGE_ME@pg-host:5432/panel?sslmode=verify-full
# RATELIMIT_STORAGE_URI=redis://panel:CHANGE_ME@data-vm-host:6379/0
# No local Redis on this host, so BOT_EVENTS_REDIS_URI may be left empty — it defaults to
# the RATELIMIT_STORAGE_URI above, which already points at the data tier.

# --- Standalone bot host (docker-compose.bot.yml) ---
# Runs PANEL_ROLE=bot (bot-api) against the data tier's Postgres (read-write user, needed to
# provision/extend clients) and the data tier's Redis (panel-snapshot cache + bot:events pubsub),
# with the tg_bot service pointed at the local bot-api instead of the master backend.
# bot-api provisions trial/checkout itself: tariff items carrying a panel_id go straight to that
# node over federation, so the master is not in the purchase path at all. A tariff item without a
# panel_id has nowhere to go on this host and fails loudly — always set panel_id on bot-host tariffs.
# IMPORTANT: one Telegram token may only long-poll once — when adopting this dedicated bot host,
# stop/remove the master stack's own 'bot' service first, or the two pollers 409-conflict.
# IMPORTANT: the bot is the ONLY subscriber of bot:events — point it at the data tier's Redis,
# never at the master's. Wrong host = a healthy connection that receives zero events.
# DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@pg-host:5432/panel?sslmode=verify-full
# RATELIMIT_STORAGE_URI=redis://panel:CHANGE_ME@data-vm-host:6379/0
# BOT_EVENTS_REDIS_URI=redis://panel:CHANGE_ME@data-vm-host:6379/0
# BOT_SERVICE_TOKEN=
# Its own Caddy terminates TLS for BOT_DOMAIN (set above) and publishes ONLY the YooKassa webhook:
# the caddy service is handed BOT_DOMAIN and nothing else (no env_file), so every other route in
# caddy/routes.yaml interpolates empty and caddygen drops it. Do not add PANEL_DOMAIN/SUB_DOMAIN
# there "for symmetry" — `${VAR:-}` substitutes the .env value, it does not pass an empty string.
# The cert covering BOT_DOMAIN is issued BY HAND on this box (Caddy crash-loops until
# ./certs/fullchain.pem exists, so do it before the first `up`). scripts/generate_certs.sh cannot
# do it — it passes -d "$PANEL_DOMAIN" unconditionally (that name resolves to the master, so the
# HTTP-01 challenge fails and certbot fails the whole run) and its `docker compose stop/up caddy`
# calls carry no -f, so they would resolve the legacy monolithic docker-compose.yml. Exactly like
# the sub host. The recipe is in CLAUDE.md, "Deploy note — the payment surface moved to bot-api".
