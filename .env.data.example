# ─────────────────────────────────────────────────────────────────────────────
# Data tier — docker-compose.postgres.yml
# Copy to .env ON THE DATA VM ONLY.
#
# There is deliberately no single shared .env.example any more. One file could never
# be correct for every host. Every host gets its own file holding only what it reads.
#
# This host runs: Postgres (the single source of truth), the shared Redis carrying the
# bot:events bus and the node snapshots, and the pg-backup sidecar. It serves master,
# sub, bot-api, the bot and every node — and it must not be reachable beyond them.
# ─────────────────────────────────────────────────────────────────────────────

# --- Images ---
REDIS_IMAGE=redis:7.4-alpine
# Postgres is pinned to postgres:16 inside the compose file, not by a variable.

# --- Postgres ---
# The same credentials go into the other hosts' DATABASE_URL, where sslmode=verify-full
# is enforced — so the host name they use must match this server's certificate.
POSTGRES_USER=panel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=panel

# --- Redis ACL passwords ---
# panel — full access minus @dangerous (master, bot-api, sub, bot)
# node  — publish-only into bot:events, nothing else
# The password travels inside the URI (redis://user:PASS@host), so @ : / ? # have to be
# percent-encoded. Easiest is a password without them: openssl rand -hex 32
# Both are left blank on purpose and the stack will NOT start until you fill them:
# compose's `${VAR:?}` treats an empty value as missing, which is the right refusal for
# a credential — a shipped placeholder password is worse than a failed `up`.
REDIS_PANEL_PASSWORD=
REDIS_NODE_PASSWORD=
# REDIS_BOT_PASSWORD — the Telegram poller. It is the one process in the deployment that feeds
#                      untrusted internet input to something other than a web framework, and it
#                      needs exactly one thing from the bus: SUBSCRIBE to bot:events. It used to be
#                      handed the `panel` credential, which reads every node snapshot (every user's
#                      UUID, telegram_id, e-mail, traffic and expiry) and writes anything it likes
#                      into the bus. bot-api keeps `panel` — it publishes.
REDIS_BOT_PASSWORD=

# --- TLS: both ports on this host are encrypted, and both need the same certificate ---
# Postgres has served TLS since wave 1; Redis does too since wave 8, and its port now speaks
# TLS ONLY (`--port 0 --tls-port 6379`), so every client URI must be rediss://. Plain redis://
# was authenticated by ACL but never encrypted, and a node snapshot on that wire carries every
# client's UUID and the inbound's REALITY *private* key — enough to use somebody's key and to
# impersonate the node itself.
#
# Both services read ./pg_certs/server.crt and ./pg_certs/server.key. Nothing in this repo
# generates them. The supported model is a publicly-trusted certificate for this VM's own DNS
# name — issue it here with certbot and copy it in:
#
#   certbot certonly --standalone -d data.example.com
#   mkdir -p ./pg_certs
#   cp -L /etc/letsencrypt/live/data.example.com/fullchain.pem ./pg_certs/server.crt
#   cp -L /etc/letsencrypt/live/data.example.com/privkey.pem   ./pg_certs/server.key
#   chown 999:999 ./pg_certs/server.*   # uid 999 is postgres AND redis in these images
#   chmod 600 ./pg_certs/server.key
#
# The clients' URIs must then use that same name — the certificate is checked against the
# hostname, not the address. Renewal is manual, same as every other certificate here.

# --- Network exposure: the one setting on this host that can hurt you ---
# *_BIND is the host interface each port is published on. Both default to 127.0.0.1 in
# the compose file, i.e. closed, so an unset value cannot publish the data tier to the
# internet. Set them to THIS VM's private-network address so the other hosts can reach
# it — never to 0.0.0.0 unless a firewall in front is doing the narrowing instead.
#
# Postgres is reasonably covered even when exposed: ssl=on, scram-sha-256, and clients
# are required to use sslmode=verify-full.
# Redis is NOT: it runs without TLS entirely, so the ACL password and every bot:events
# payload — telegram_id and client e-mails — cross the wire in clear. Keep it on a
# private network between hosts, or move the bus to rediss://.
POSTGRES_BIND=10.0.0.10
REDIS_BIND=10.0.0.10

# --- Backups ---
# pg-backup dumps every 6 hours into ./pg_backups on THIS machine, keeps 14 and does not
# encrypt them. Those dumps carry bot_token, yookassa_secret_key, bot_service_token and
# every federation_token in plaintext, and they sit on the same disk as ./pg_data —
# losing this VM loses the database and its backups together. Ship them off-host.
