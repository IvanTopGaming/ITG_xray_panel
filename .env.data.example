# ═════════════════════════════════════════════════════════════════════════════
#  DATA TIER  ·  Postgres + Redis + backups  ·  docker-compose.postgres.yml
#  cp .env.data.example .env   —  on the data VM only
#
#  This box makes no outbound connections, and that is its whole value. Bring it
#  up first. Both services speak TLS off ./pg_certs/server.{crt,key}, so that
#  pair must be issued for the hostname the other hosts write in their URIs.
# ═════════════════════════════════════════════════════════════════════════════

# ── Images ───────────────────────────────────────────────────────────────────
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7.4-alpine

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=panel          # the role every service host connects as
POSTGRES_PASSWORD=CHANGE_ME  # goes into DATABASE_URL on four other hosts
POSTGRES_DB=panel            # database name

# ── Redis ACL: three users, three different reaches ──────────────────────────
# panel — everything except the dangerous commands; master, sub, bot-api, cron
# node  — publish into bot:events and nothing else; safe in an untrusted segment
# bot   — subscribe to bot:events only; the poller reads no snapshots
REDIS_PANEL_PASSWORD=  # used by master, sub, bot-api and cron
REDIS_NODE_PASSWORD=   # used by every node
REDIS_BOT_PASSWORD=    # used by the Telegram poller alone

# ── Exposure ─────────────────────────────────────────────────────────────────
# Both default to 127.0.0.1 when unset, i.e. closed. Set them to this VM's
# private-network address — never a public one.
POSTGRES_BIND=10.0.0.10  # interface the Postgres port publishes on
REDIS_BIND=10.0.0.10     # interface the Redis port publishes on
