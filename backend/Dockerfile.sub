FROM node:20-alpine AS ui

WORKDIR /ui

COPY --from=project frontend/package.json frontend/package-lock.json ./
COPY --from=project frontend/packages/ui-core/package.json packages/ui-core/
COPY --from=project frontend/packages/admin/package.json packages/admin/
COPY --from=project frontend/packages/node/package.json packages/node/
COPY --from=project frontend/packages/sub-page/package.json packages/sub-page/

RUN npm ci

COPY --from=project frontend/ ./

RUN npm run build --workspace @panel/sub-page

FROM python:3.12-slim AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0
ENV PATH="/app/.venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
COPY packages/panel-core/pyproject.toml packages/panel-core/
COPY packages/panel-adminapi/pyproject.toml packages/panel-adminapi/
COPY packages/panel-worker/pyproject.toml packages/panel-worker/
COPY packages/panel-master/pyproject.toml packages/panel-master/
COPY packages/panel-sub/pyproject.toml packages/panel-sub/
COPY packages/panel-botapi/pyproject.toml packages/panel-botapi/
COPY packages/panel-cron/pyproject.toml packages/panel-cron/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package panel-sub --no-install-workspace

COPY packages/ packages/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package panel-sub

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"

COPY --from=builder /app /app

COPY --from=project versions.json /app/versions.json

COPY . .

COPY --from=ui /ui/packages/sub-page/dist /app/ui

CMD ["python", "run.py"]
