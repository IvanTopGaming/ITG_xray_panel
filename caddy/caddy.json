{
	"apps": {
		"tls": {
			"certificates": {
				"load_files": [
					{
						"certificate": "/root/cert/fullchain.pem",
						"key": "/root/cert/key.pem"
					}
				]
			}
		},
		"http": {
			"servers": {
				"panel_security_layer": {
					"listen": [
						"127.0.0.1:8081"
					],
					"listener_wrappers": [
						{
							"wrapper": "proxy_protocol",
							"allow": [
								"127.0.0.1/32"
							]
						}
					],
					"routes": [
						{
							"handle": [
								{
									"handler": "headers",
									"response": {
										"set": {
											"Strict-Transport-Security": [
												"max-age=63072000; includeSubDomains; preload"
											],
											"X-XSS-Protection": [
												"1; mode=block"
											],
											"X-Content-Type-Options": [
												"nosniff"
											],
											"X-Frame-Options": [
												"SAMEORIGIN"
											],
											"Referrer-Policy": [
												"strict-origin-when-cross-origin"
											],
											"Content-Security-Policy": [
												"default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https: wss:;"
											]
										}
									}
								},
								{
									"handler": "reverse_proxy",
									"upstreams": [
										{
											"dial": "frontend:80"
										}
									],
									"headers": {
										"request": {
											"set": {
												"X-Real-IP": [
													"{http.vars.client_ip}"
												],
												"X-Forwarded-Proto": [
													"https"
												]
											}
										}
									}
								}
							]
						}
					]
				}
			}
		},
		"layer4": {
			"servers": {
				"main": {
					"listen": [
						":443"
					],
					"routes": [
						{
							"match": [
								{
									"tls": {
										"sni": [
											"${PROXY_DOMAIN}"
										]
									}
								}
							],
							"handle": [
								{
									"handler": "proxy",
									"proxy_protocol": "v2",
									"upstreams": [
										{
											"dial": [
												"xray:443"
											]
										}
									]
								}
							]
						},
						{
							"match": [
								{
									"tls": {
										"sni": [
											"${PANEL_DOMAIN}"
										]
									}
								}
							],
							"handle": [
								{
									"handler": "tls",
									"connection_policies": [
										{
											"alpn": [
												"http/1.1"
											]
										}
									]
								},
								{
									"handler": "proxy",
									"proxy_protocol": "v2",
									"upstreams": [
										{
											"dial": [
												"127.0.0.1:8081"
											]
										}
									]
								}
							]
						}
					]
				}
			}
		}
	}
}
