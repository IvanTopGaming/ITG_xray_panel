# ═════════════════════════════════════════════════════════════════════════════
#  BOT  ·  Telegram poller + bot-api + billing  ·  docker-compose.bot.yml
#  cp .env.bot.example .env   —  on the bot box only
#
#  Serves the YooKassa webhook and runs all three payment crons. While this box
#  is down NO payment is confirmed at all — there is no second host that can.
#  Point the merchant dashboard at https://<BOT_DOMAIN>/api/billing/yookassa/webhook
# ═════════════════════════════════════════════════════════════════════════════

# ── Images ───────────────────────────────────────────────────────────────────
BOT_API_IMAGE=ghcr.io/ivantopgaming/panel-bot-api:v2.4.16
BOT_IMAGE=ghcr.io/ivantopgaming/panel-bot:v2.2.7
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.2

# ── Domains & TLS ────────────────────────────────────────────────────────────
BOT_DOMAIN=bot.example.com      # this host; only the webhook path is served
SUB_DOMAIN=sub.example.com      # the SUB host; every bot link is built from it
PANEL_DOMAIN=panel.example.com  # routes nothing here; the "real deploy" marker

# ── Admin login & JWT ────────────────────────────────────────────────────────
SECRET_KEY=change-this-super-long-random-secret  # JWT signing key, 32+ chars

# ── Data tier ────────────────────────────────────────────────────────────────
# sslrootcert is NOT optional: without it the role cannot connect at all,
# because no container carries the ~/.postgresql/root.crt libpq looks for.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data.example.com:5432/panel?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt

# ── Redis: two containers, two credentials, on purpose ───────────────────────
# bot-api publishes and reads node snapshots, so it keeps 'panel'. The poller
# only listens to one channel, so it gets 'bot' — subscribe-only, and it is the
# one process here feeding untrusted internet input to something else.
RATELIMIT_STORAGE_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0
SHARED_REDIS_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0
BOT_SHARED_REDIS_URI=rediss://bot:CHANGE_ME@data.example.com:6379/0

# ── Telegram ─────────────────────────────────────────────────────────────────
# The token and everything else bot-side live in the panel UI (Bot → Settings),
# not here. Rotating it there stops the bot until this value is updated.
BOT_SERVICE_TOKEN=  # copy from Bot → Settings after the first boot
BOT_LOG_LEVEL=INFO  # the aiogram poller's own verbosity

# ── Optional ─────────────────────────────────────────────────────────────────
BACKEND_LOG_LEVEL=INFO  # DEBUG also echoes every SQL statement
