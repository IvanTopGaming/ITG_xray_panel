# ─────────────────────────────────────────────────────────────────────────────
# Standalone bot host — docker-compose.bot.yml
# Copy to .env ON THE BOT BOX ONLY.
#
# There is deliberately no single shared .env.example any more. One file could never
# be correct for every host: RATELIMIT_STORAGE_URI alone has two mutually exclusive
# right values — the box's own Redis on the master and on a node, the data tier here
# and on the sub host. Every host gets its own file holding only what that host reads.
#
# This host runs: bot-api (PANEL_ROLE=bot — /bot-service/*, the billing surface and the
# three payment crons), the Telegram bot itself, and a Caddy terminating TLS for
# BOT_DOMAIN that publishes ONLY /api/billing/yookassa/webhook.
#
# This is the single point of acceptance for payments: the YooKassa webhook lives here
# and nowhere else, and so do poll_pending_payments, reconcile_refunds and
# cleanup_old_payments. While this box is down, no payment is confirmed at all.
# ─────────────────────────────────────────────────────────────────────────────

# --- Images (keep the tags in sync with versions.json) ---
BOT_API_IMAGE=ghcr.io/ivantopgaming/panel-bot-api:v2.4.10
BOT_IMAGE=ghcr.io/ivantopgaming/panel-bot:v2.2.4
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v1.1.2

# --- Domains, routing & TLS ---
# BOT_DOMAIN        — THIS host's domain, and the only route its Caddy serves. Point the
#                     YooKassa merchant dashboard's webhook URL at
#                     https://<BOT_DOMAIN>/api/billing/yookassa/webhook.
#                     ./certs on this box must hold a cert covering it; issue it by hand
#                     (the recipe is in CLAUDE.md) BEFORE the first `up` — Caddy
#                     crash-loops until ./certs/fullchain.pem exists.
# SUB_DOMAIN        — REQUIRED, and it is the subscription host's domain, not this one.
#                     bot-api builds every subscription link the bot hands a user, in its
#                     own process, out of its own environment
#                     (services/sub_links.build_aggregate_sub_url, reached from
#                     GET /bot-service/users/<id>/state). There is no fallback: wave 3b
#                     deleted the PANEL_DOMAIN + secret-path one, so with SUB_DOMAIN unset
#                     build_aggregate_sub_url returns None and the bot has no link to show
#                     at all — not to a browser and not to a client app.
# PANEL_DOMAIN      — not a route here, and nothing on this host serves it. It is the
#                     "is this a real deployment" marker: a non-local value is what makes
#                     app_base refuse a weak SECRET_KEY and db_config refuse a
#                     DATABASE_URL without sslmode=verify-full. This box's Caddy is handed
#                     BOT_DOMAIN and nothing else.
# No PANEL_SECRET_PATH here: the only module that reads it is api/federation.py, which
# ships from panel-adminapi and is not installed in the bot-api image.
BOT_DOMAIN=bot.example.com
SUB_DOMAIN=sub.example.com
PANEL_DOMAIN=panel.example.com

# --- JWT signing ---
# No PANEL_ADMIN_* here: this role never calls bootstrap_defaults and creates no Admin
# row. It registers no auth blueprint either.
SECRET_KEY=change-this-super-long-random-secret

# --- Data tier ---
# Read-write: bot-api provisions and extends clients itself. Tariff items carrying a
# panel_id go straight to that node over federation; the master is not in the purchase
# path at all. An item without a panel_id has nowhere to go here, and since wave 5a such a
# tariff is refused before an invoice exists — it is hidden from the bot's catalogue, the
# checkout returns tariff_not_available, and no money is taken for it.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data-vm.internal:5432/panel?sslmode=verify-full

# --- Redis: two variables, one instance on this host ---
# There is no local Redis here, so both point at the data tier. They used to be one
# variable with the other defaulting to it; that default is gone, because on the master
# and on a node it silently pointed the bus at a Redis nobody subscribes to.
# RATELIMIT_STORAGE_URI — rate limits for bot-api.
# SHARED_REDIS_URI      — the bot:events bus (bot-api publishes, the bot subscribes) and
#                         the node snapshots bot-api reads. Both containers on this host
#                         need it. The bot is the ONLY subscriber of bot:events: pointed
#                         at the wrong instance it connects happily and receives nothing
#                         at all, with no error anywhere.
RATELIMIT_STORAGE_URI=redis://panel:CHANGE_ME@data-vm.internal:6379/0
SHARED_REDIS_URI=redis://panel:CHANGE_ME@data-vm.internal:6379/0

# --- Telegram bot ---
# Fill after the first login on the master: Panel → Bot → Settings → rotate token.
# Everything else the bot needs (bot_token, admin IDs, telegram proxy, YooKassa
# credentials, timezone) is configured in that UI and stored in Postgres, not here.
# One Telegram token may only long-poll once: stop any other bot process using it.
BOT_SERVICE_TOKEN=
BOT_LOG_LEVEL=INFO

# --- Logging ---
BACKEND_LOG_LEVEL=INFO
