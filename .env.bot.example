# ═════════════════════════════════════════════════════════════════════════════
#  BOT  ·  Telegram poller + bot-api + billing  ·  docker-compose.bot.yml
#  cp .env.bot.example .env   —  on the bot box only
#
#  Serves the YooKassa webhook and runs all three payment crons. While this box
#  is down NO payment is confirmed at all — there is no second host that can.
#  The webhook URL carries BOT_WEBHOOK_PATH; the installer prints the full one.
# ═════════════════════════════════════════════════════════════════════════════

# ── Images ───────────────────────────────────────────────────────────────────
BOT_API_IMAGE=ghcr.io/ivantopgaming/panel-bot-api:v3.0.0
BOT_IMAGE=ghcr.io/ivantopgaming/panel-bot:v3.0.0
CADDY_IMAGE=ghcr.io/ivantopgaming/panel-caddy:v3.0.0

# ── Domains & TLS ────────────────────────────────────────────────────────────
# SUB_DOMAIN names the subscription host, not this one, and it is required here:
# every link the bot sends a user is built from it, and there is no fallback.
BOT_DOMAIN=bot.example.com                # this host; one path is served, rest 404
BOT_WEBHOOK_PATH=change-this-secret-path  # the webhook sits under /<this>/
SUB_DOMAIN=sub.example.com                # the SUB host; bot links are built from it
PANEL_DOMAIN=panel.example.com            # routes nothing here; "real deploy" marker

# ── Admin login & JWT ────────────────────────────────────────────────────────
SECRET_KEY=change-this-super-long-random-secret  # JWT signing key, 32+ chars

# ── Data tier ────────────────────────────────────────────────────────────────
# sslrootcert points at the data tier's own CA, mounted into this container by
# the compose file. It is NOT optional and cannot be dropped: verify-full is
# enforced, the CA is not in any public trust store, and libpq's own fallback
# (~/.postgresql/root.crt) does not exist here. The installer writes ./ca.crt.
DATABASE_URL=postgresql+psycopg2://panel:CHANGE_ME@data.example.com:5432/panel?sslmode=verify-full&sslrootcert=/etc/ssl/panel-ca.crt

# ── Redis: two containers, two credentials, on purpose ───────────────────────
# bot-api publishes and reads node snapshots, so it keeps 'panel'. The poller
# only listens to one channel, so it gets 'bot' — subscribe-only, and it is the
# one process here feeding untrusted internet input to something else.
RATELIMIT_STORAGE_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0?ssl_ca_certs=/etc/ssl/panel-ca.crt
SHARED_REDIS_URI=rediss://panel:CHANGE_ME@data.example.com:6379/0?ssl_ca_certs=/etc/ssl/panel-ca.crt
BOT_SHARED_REDIS_URI=rediss://bot:CHANGE_ME@data.example.com:6379/0?ssl_ca_certs=/etc/ssl/panel-ca.crt

# ── Telegram ─────────────────────────────────────────────────────────────────
# The token and everything else bot-side live in the panel UI (Bot → Settings),
# not here. Rotating it there stops the bot until this value is updated.
BOT_SERVICE_TOKEN=  # copy from Bot → Settings after the first boot
BOT_LOG_LEVEL=INFO  # the aiogram poller's own verbosity

# ── TLS ──────────────────────────────────────────────────────────────────────
# Caddy issues and renews the certificate itself over ACME. Requirements:
# BOT_DOMAIN resolves here and :80 is reachable — YooKassa needs the webhook.
ACME_EMAIL=             # optional; where Let's Encrypt mails warnings
ACME_CA=                # optional; LE staging URL while rehearsing

# ── Optional ─────────────────────────────────────────────────────────────────
BACKEND_LOG_LEVEL=INFO  # DEBUG also echoes every SQL statement
